APP_URL=http://localhost:3000
DATABASE_PATH=./data/commerce.sqlite
PAYMENT_PROVIDER=demo
SESSION_SECRET=
ADMIN_PASSWORD=
COOKIE_SECURE=false
# Set provider to paytr only after configuring the merchant sandbox.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
# Use an explicit public test IP for local merchant testing; never used in live mode.
PAYTR_TEST_USER_IP=
# Enable only behind a proxy that replaces client-supplied forwarding headers.
TRUST_PROXY=false
